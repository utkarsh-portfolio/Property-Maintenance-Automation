# Application
APP_NAME="Property Maintenance Automation"
DEBUG=true

# Database (Neon PostgreSQL - Free tier)
DATABASE_URL=postgresql+asyncpg://user:password@your-neon-host.neon.tech/property_maintenance

# Redis (Upstash - Free tier)
REDIS_URL=redis://default:password@your-upstash-host.upstash.io:6379

# AI - Groq (Free tier - get key at console.groq.com)
GROQ_API_KEY=your_groq_api_key
LLM_MODEL=llama-3.1-70b-versatile

# Twilio (Free trial - get at twilio.com/console)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# JWT Auth
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
